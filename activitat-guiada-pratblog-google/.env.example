# Copia aquest fitxer amb el nom .env i omple-hi els teus valors.
# El fitxer .env NO es puja mai a GitHub (és al .gitignore).

# ID de client OAuth de Google Cloud (acaba en .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=posa-aqui-el-teu-id.apps.googleusercontent.com

# Correus que poden entrar a l'administració, separats per comes
VITE_ADMINS=el-teu-correu@gmail.com
