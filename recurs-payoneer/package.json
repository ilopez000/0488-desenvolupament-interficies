{
  "name": "recurs-payoneer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c magenta,cyan \"npm:servidor\" \"npm:web\"",
    "web": "vite",
    "servidor": "node --env-file=.env --watch servidor/servidor.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@payoneer/checkout-web": "^1.34.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
