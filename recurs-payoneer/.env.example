# ─────────────────────────────────────────────────────────────
#  Recurs 0488 · Pagaments amb Payoneer Checkout
#  Copia aquest fitxer com a .env (arrenca.bat ho fa sol).
#  El .env NO es puja mai a GitHub: hi ha les credencials.
# ─────────────────────────────────────────────────────────────

# simulacio → no cal cap compte: el servidor imita Payoneer (per a classe)
# sandbox   → crida de debò l'entorn de proves de Payoneer (cal compte de comerciant)
PAYONEER_MODE=simulacio

# Credencials del portal de comerciant de Payoneer Checkout (només en mode sandbox)
PAYONEER_MERCHANT_CODE=
PAYONEER_API_TOKEN=
# Codi de la botiga («division») que et dona el portal
PAYONEER_DIVISION=

# Servidor de l'API. Sandbox: https://api.sandbox.oscato.com/api · Real: https://api.live.oscato.com/api
PAYONEER_API_URL=https://api.sandbox.oscato.com/api

# On escolta el nostre servidor i on és la web de React
PORT=3001
URL_WEB=http://localhost:5173

# URL pública per rebre les notificacions (opcional; p. ex. un túnel de cloudflared)
# Si es deixa buida, Payoneer no ens podrà avisar i consultarem l'estat nosaltres.
URL_PUBLICA_NOTIFICACIONS=
