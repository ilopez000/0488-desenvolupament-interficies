{
  "name": "recurs-login-google-d1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remota": "vite --mode remota",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:local": "wrangler d1 migrations apply login-google-d1-db --local",
    "db:remote": "wrangler d1 migrations apply login-google-d1-db --remote",
    "db:veure": "wrangler d1 execute login-google-d1-db --local --command \"SELECT id, email, alies, cicle, visites, ultim_acces FROM users\"",
    "db:veure-remota": "wrangler d1 execute login-google-d1-db --remote --command \"SELECT id, email, alies, cicle, visites, ultim_acces FROM users\""
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
