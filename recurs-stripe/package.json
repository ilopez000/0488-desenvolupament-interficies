{
  "name": "recurs-stripe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c magenta,cyan \"npm:servidor\" \"npm:web\"",
    "servidor": "node --env-file=.env --watch servidor.mjs",
    "web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  }
}
